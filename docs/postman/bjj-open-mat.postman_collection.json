                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-07-28\",\n  \"whatWasTaught\": \"Arm bar from guard\",\n  \"techniqueTags\": [\"arm-bar\", \"guard\"],\n  \"rounds\": 5,\n  \"intensity\": 3,\n  \"partners\": 2,\n  \"note\": \"Good drilling session\",\n  \"shared\": false\n}"
