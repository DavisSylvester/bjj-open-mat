              "raw": "{\n  \"title\": \"Evening Fundamentals\",\n  \"startTime\": \"18:00\",\n  \"endTime\": \"19:00\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/classes/CLASS_ID"
          }
        },
        {
          "name": "Archive class",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/classes/CLASS_ID"
          }
        },
