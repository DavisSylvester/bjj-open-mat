# BJJ Open Mat API
# Copy to .env and set values before running locally.

PORT=3100

# Google Places API (New) key. Optional — without it the gym review hand-off
# is simply omitted. Needs the Places API (New) enabled on the GCP project.
GOOGLE_PLACES_API_KEY=

# Google Maps SDK key used by the mobile build (-PmapsApiKey). Keep the real
# value in an untracked .env file, never here.
MAPS_API_KEY=
